# Copy to backend/.env and adjust. Every setting is optional; defaults suit local development.

# Where the SQLite DB, LangGraph checkpoints and uploads live.
FINQA_DATA_DIR=./data
# Postgres instead of SQLite (needs: pip install ".[postgres]"):
# FINQA_DATABASE_URL=postgresql+psycopg://finqa:finqa@localhost:5432/finqa

# Optional LLM fallback for unknown row labels (needs: pip install ".[llm]" and the provider's API key).
# FINQA_LLM_MODEL=anthropic:<model-name>
# ANTHROPIC_API_KEY=...

# Demo bearer tokens "token:user:role" (roles: analyst, controller, auditor, admin). Change these.
FINQA_AUTH_TOKENS=analyst-token:alice:analyst,controller-token:carol:controller,auditor-token:arun:auditor,admin-token:adam:admin

# Reconciliation defaults (admins can override at runtime on the Review rules page).
FINQA_ANOMALY_THRESHOLD=0.30
FINQA_WORKER_THREADS=2
FINQA_LOG_LEVEL=INFO
FINQA_LOG_JSON=false
